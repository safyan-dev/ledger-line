{
  "Webhooks": {
    "Ingestion": {
      "AckBudgetMs": 5,
      "MaxPayloadBytes": 1048576,
      "StuckMinutes": 5,
      "OutboxBatchSize": 20,
      "OutboxPollMilliseconds": 500,
      "MaxAttempts": 5,
      "RetryBaseSeconds": 5
    }
  },
  "Database": {
    "MigrateOnStartup": true,
    "SeedDemoData": false
  },
  "RateLimiting": {
    "GlobalPermitLimit": 300,
    "GlobalWindowSeconds": 60,
    "AuthPermitLimit": 10,
    "AuthWindowSeconds": 60,
    "RegistrationPermitLimit": 5,
    "RegistrationWindowSeconds": 3600
  },
  "Observability": {
    "ServiceName": "ledgerline-api",
    "OtlpEndpoint": "http://localhost:4317"
  },
  "Jwt": {
    "Issuer": "ledgerline",
    "Audience": "ledgerline-api",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1"
}
